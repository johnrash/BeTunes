/*
 * BeTunes application resources.
 */

resource app_signature "application/x-vnd.BeTunes";

/* One instance: opening more files from Tracker or the command line adds
 * them to the running BeTunes. */
resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 1,
	short_info = "BeTunes",
	long_info = "A music player in the spirit of iTunes from the mid 2000s."
};

/* Shown in Tracker's "Open with" menu for audio files and folders. */
resource file_types message {
	"types" = "audio",
	"types" = "application/ogg",
	"types" = "application/x-ogg",
	"types" = "application/x-vnd.Be-directory"
};

/* Application icon (HVIF, generated by tools/make_icon.py). */
resource(101, "BEOS:ICON") #'VICN' import "artwork/BeTunes.hvif";
